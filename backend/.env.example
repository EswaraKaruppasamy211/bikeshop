PORT=3001
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require
FRONTEND_ORIGIN=http://localhost:5173

# Single backend-provisioned administrator; no public registration endpoint exists.
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Optional server-side OpenAI-compatible Chat Completions provider.
# Remote AI_API_URL values must use HTTPS; only loopback development URLs may use HTTP.
# Configure all three values locally in backend/.env; never use VITE_* variables.
# Example URL: https://api.openai.com/v1/chat/completions
AI_API_URL=
# Provider-issued API key; never commit or expose this value.
AI_API_KEY=
# Provider model identifier.
AI_MODEL=

# Optional path to data/reference-catalogue.json.
REFERENCE_CATALOGUE_PATH=
